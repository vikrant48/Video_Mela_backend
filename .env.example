# Server Configuration
PORT=8000
NODE_ENV=production
# Proxies in front of the app: 1 = clients call Render directly, 2 = through the Vercel /api/v1 rewrite
TRUST_PROXY_HOPS=1

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net

ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS: frontend origins allowed to call the API
COOKIE_ORG=http://localhost:3000
FRONTEND_URL=https://your-frontend.vercel.app
LOCAL_FRONTEND_URL=http://localhost:5173

# Email (password reset and email change codes). Without SMTP, codes are only
# printed to the console outside production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
SMTP_FROM="VideoMela" <you@example.com>
